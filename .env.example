# Copiar este archivo a .env y completar con valores reales.
# .env NUNCA se sube al repositorio (ver .gitignore).

DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=tivoscanea_db
DB_USER=tivoscanea_user
DB_PASSWORD=cambiar-por-una-password-segura
DB_HOST=localhost
DB_PORT=5432

# Reglas de negocio configurables
PLAZO_ANULACION_VENTA_MINUTOS=30
UMBRAL_CAIDA_VENTAS_PORCENTAJE=20
