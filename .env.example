# Copiar este archivo a .env y completar con valores reales.
# .env NUNCA se sube al repositorio (ver .gitignore).

DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=tivoscanea_db
DB_USER=tivoscanea_user
DB_PASSWORD=cambiar-por-una-password-segura
DB_HOST=localhost
DB_PORT=5432

# Correo saliente (recuperación de contraseña). Sin EMAIL_HOST: con DEBUG=True los
# correos se imprimen en la consola de runserver; sin DEBUG no se ofrece el envío.
# EMAIL_HOST=smtp.proveedor.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=TivoScanea <no-responder@dominio.example>

# Reglas de negocio configurables
UMBRAL_CAIDA_VENTAS_PORCENTAJE=20
